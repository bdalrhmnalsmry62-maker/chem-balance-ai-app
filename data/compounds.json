const page = window.location.pathname;
const compoundsUrl = '/data/compounds.json';

const loadCompounds = async () => {
  const response = await fetch(compoundsUrl);
  const data = await response.json();
  return data.compounds || [];
};

const renderCompounds = (list) => {
  const grid = document.getElementById('compounds');
  if (!grid) return;

  const query = (document.getElementById('compoundSearch')?.value || '').trim().toLowerCase();
  const filtered = list.filter((item) => {
    const values = [item.ar, item.en, item.formula];
    return values.some((v) => String(v).toLowerCase().includes(query));
  });

  grid.innerHTML = filtered.map((item) => `
    <div class="compound-item" data-formula="${item.formula}">
      <span class="compound-name">${item.ar}</span>
      <span class="compound-formula">${item.formula}</span>
      <span>${item.en}</span>
    </div>
  `).join('') || '<p>لا توجد نتائج مطابقة للبحث.</p>';

  Array.from(document.querySelectorAll('.compound-item')).forEach((item) => {
    item.addEventListener('click', () => {
      const input = document.getElementById('equationInput');
      if (!input) return;
      const value = item.getAttribute('data-formula');
      const current = input.value.trim();
      input.value = current ? `${current} + ${value}` : value;
      input.focus();
    });
  });
};

const parseFormula = (formula) => {
  const counts = {};
  const regex = /([A-Z][a-z]?)(\d*)/g;
  let match;
  while ((match = regex.exec(formula))) {
    const element = match[1];
    const count = Number.parseInt(match[2] || '1', 10);
    counts[element] = (counts[element] || 0) + count;
  }
  return counts;
};

const gcd = (a, b) => {
  let x = Math.abs(a);
  let y = Math.abs(b);
  while (y) {
    const temp = x % y;
    x = y;
    y = temp;
  }
  return x;
};

const normalize = (arr) => {
  let divisor = arr[0];
  for (let i = 1; i < arr.length; i++) divisor = gcd(divisor, arr[i]);
  return arr.map((n) => n / divisor);
};

const solveEquationLocally = (equation) => {
  const normalized = equation.replace(/→/g, '->');
  const [leftPart, rightPart] = normalized.split(/\s*->\s*/);
  if (!leftPart || !rightPart) throw new Error('استخدم السهم -> لتفصل بين الطرفين.');

  const left = leftPart.split('+').map((x) => x.trim()).filter(Boolean);
  const right = rightPart.split('+').map((x) => x.trim()).filter(Boolean);
  const molecules = [...left, ...right];
  const elements = Array.from(new Set(molecules.flatMap((m) => Object.keys(parseFormula(m)))));

  const search = (index, coeffs) => {
    if (index === molecules.length) {
      const totals = {};
      for (const element of elements) totals[element] = 0;

      left.forEach((molecule, i) => {
        const counts = parseFormula(molecule);
        for (const element of elements) totals[element] += (counts[element] || 0) * coeffs[i];
      });

      right.forEach((molecule, i) => {
        const counts = parseFormula(molecule);
        for (const element of elements) totals[element] -= (counts[element] || 0) * coeffs[left.length + i];
      });

      if (Object.values(totals).every((v) => v === 0)) return coeffs;
      return null;
    }

    for (let value = 1; value <= 12; value += 1) {
      coeffs[index] = value;
      const result = search(index + 1, coeffs);
      if (result) return result;
    }

    return null;
  };

  const coeffs = new Array(molecules.length).fill(1);
  const solution = search(0, coeffs);
  if (!solution) throw new Error('تعذر إيجاد معادلة متوازنة في هذه النسخة. جرّب معادلة أخرى أو استخدم مثالاً جاهزاً.');

  const result = normalize(solution);
  const leftCoeffs = result.slice(0, left.length);
  const rightCoeffs = result.slice(left.length);

  const leftText = left.map((m, i) => `${leftCoeffs[i] === 1 ? '' : leftCoeffs[i]}${m}`).join(' + ');
  const rightText = right.map((m, i) => `${rightCoeffs[i] === 1 ? '' : rightCoeffs[i]}${m}`).join(' + ');

  return {
    balanced: `${leftText} -> ${rightText}`,
    explanation: `تم ترتيب معاملات مناسبة للحفاظ على عدد الذرات في الطرفين. تم تحليل العناصر المشتركة في ${elements.join('، ')}، ثم تم إيجاد القيم الصحيحة الأصغر الممكنة.`
  };
};

const balanceEquation = async (equation) => {
  const response = await fetch('/api/balance', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ equation })
  });

  const data = await response.json();
  if (!response.ok) throw new Error(data.error || 'حدث خطأ أثناء الموازنة.');
  return data;
};

const initCompoundsPage = async () => {
  if (!document.getElementById('compounds')) return;
  const compounds = await loadCompounds();
  renderCompounds(compounds);

  const input = document.getElementById('compoundSearch');
  input.addEventListener('input', () => renderCompounds(compounds));
};

const initBalancerPage = () => {
  const button = document.getElementById('balanceBtn');
  const exampleBtn = document.getElementById('exampleBtn');
  const input = document.getElementById('equationInput');
  const errorBox = document.getElementById('balanceError');
  const resultBox = document.getElementById('balanceResult');
  const finalEquation = document.getElementById('balancedEquation');
  const explanation = document.getElementById('balanceExplanation');

  if (!button) return;

  const examples = ['H2 + O2 -> H2O', 'CH4 + O2 -> CO2 + H2O', 'Fe + O2 -> Fe2O3'];
  exampleBtn.addEventListener('click', () => {
    const random = examples[Math.floor(Math.random() * examples.length)];
    input.value = random;
  });

  button.addEventListener('click', async () => {
    const equation = input.value.trim();
    if (!equation) {
      errorBox.textContent = 'أدخل المعادلة أولاً.';
      errorBox.classList.remove('hidden');
      resultBox.classList.add('hidden');
      return;
    }

    try {
      const data = await balanceEquation(equation);
      finalEquation.textContent = data.balanced || equation;
      explanation.innerHTML = `<p>${data.message || 'تم الموازنة بنجاح.'}</p><p>${data.raw ? `المعادلة المدخلة: <strong dir="ltr">${data.raw}</strong>` : ''}</p>`;
      resultBox.classList.remove('hidden');
      errorBox.classList.add('hidden');
    } catch (error) {
      errorBox.textContent = error.message;
      errorBox.classList.remove('hidden');
      resultBox.classList.add('hidden');
    }
  });
};

const initAssistantPage = () => {
  const input = document.getElementById('chatInput');
  const button = document.getElementById('sendChatBtn');
  const box = document.getElementById('chatBox');

  if (!input || !button || !box) return;

  const appendMessage = (text, type) => {
    const div = document.createElement('div');
    div.className = `message ${type}`;
    div.textContent = text;
    box.appendChild(div);
    box.scrollTop = box.scrollHeight;
  };

  const askAI = async () => {
    const message = input.value.trim();
    if (!message) return;

    appendMessage(message, 'user');
    input.value = '';

    try {
      const response = await fetch('/api/ai-chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message })
      });
      const data = await response.json();
      appendMessage(data.answer || data.error || 'لم أتمكن من الإجابة.', 'bot');
    } catch (error) {
      appendMessage('حدث خطأ في الاتصال بالمساعد.', 'bot');
    }
  };

  button.addEventListener('click', askAI);
  input.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') askAI();
  });
};

const initHomePage = () => {
  const select = document.getElementById('collegeSelect');
  if (!select) return;
  select.addEventListener('change', (event) => {
    const chosen = event.target.value;
    const title = document.querySelector('.subtitle');
    if (title) title.textContent = `قسم الكيمياء تحت رعاية الدكتورة نجوى حسين • الكلية المختارة: ${chosen}`;
  });
};

if (page.includes('/compounds.html')) initCompoundsPage();
if (page.includes('/balancer.html')) initBalancerPage();
if (page.includes('/assistant.html')) initAssistantPage();
if (page === '/' || page === '/index.html') initHomePage();
